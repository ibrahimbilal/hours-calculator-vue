VITE_FIREBASE_API_KEY=
# Must be {project-id}.firebaseapp.com from Firebase project settings — NOT your custom site URL.
# Using your own domain here breaks Google sign-in unless that domain is on Firebase Hosting.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=